{
  "name": "@yarnpkg/zpm-daemon-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "directory": "packages/zpm-daemon-ui",
    "type": "git",
    "url": "git+https://github.com/yarnpkg/zpm.git"
  },
  "scripts": {
    "codegen:daemon-types": "cargo run -p zpm --bin generate_daemon_types -- --output packages/zpm-daemon-ui/src/generated/daemon-protocol.ts",
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-router": "^1.132.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.1.11",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@yarnpkg/monorepo": "workspace:*",
    "typescript": "^5.9.3"
  }
