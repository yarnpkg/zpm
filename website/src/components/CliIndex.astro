---
type CliEntry = {id: string; data: {binaryName: string; commandSpec: {primaryPath: string[]; category: string | null; documentation?: {description?: string} | null}}};

interface Props {
  cliEntries: CliEntry[];
  cliPrefix: string;
}

const { cliEntries, cliPrefix } = Astro.props;

// Same grouping and ordering as the reference sidebar
const byCategory = new Map<string, CliEntry[]>();
for (const entry of cliEntries) {
  const cat = entry.data.commandSpec.category;
  if (!cat) continue;
  if (!byCategory.has(cat)) byCategory.set(cat, []);
  byCategory.get(cat)!.push(entry);
}

for (const items of byCategory.values())
  items.sort((a, b) => a.data.commandSpec.primaryPath.join(` `).localeCompare(b.data.commandSpec.primaryPath.join(` `)));
---

<div class="prose">
  {[...byCategory].map(([category, entries]) => (
    <Fragment>
      <h2>{category}</h2>
      <ul>
        {entries.map(entry => (
          <li>
            <a href={`/${cliPrefix}/${entry.id.replace(new RegExp(`^${cliPrefix}/`), ``)}`}><code>{`${entry.data.binaryName} ${entry.data.commandSpec.primaryPath.join(` `)}`}</code></a>
            {entry.data.commandSpec.documentation?.description && <Fragment> — {entry.data.commandSpec.documentation.description}</Fragment>}
          </li>
        ))}
      </ul>
    </Fragment>
  ))}
</div>
