---
import ContentSlide from '../ContentSlide.astro';
import Terminal from '../Terminal.astro';

interface Props {
  eyebrow: string;
  title: string;
  titleSize?: string;
  sectionTag: string;
  bottomLeft?: string;
  bottomRight?: string;
  label?: string;
  terminalTitle?: string;
  terminalId: string;
  maxWidth?: string;
}

const { eyebrow, title, titleSize = `60px`, sectionTag, bottomLeft, bottomRight, label, terminalTitle, terminalId, maxWidth = `1500px` } = Astro.props;
---

<ContentSlide sectionTag={sectionTag} bottomLeft={bottomLeft} bottomRight={bottomRight} label={label}>
  <div class="reveal reveal-1 font-mono text-sm tracking-[0.14em] text-[var(--fg-mute)] uppercase mb-7">
    {eyebrow}
  </div>

  <h2 class="slide-title reveal reveal-2 leading-[1.02] tracking-[-0.028em] font-medium m-0 mb-9 text-balance" style={`font-size: ${titleSize}`} set:html={title} />

  <div class="reveal reveal-3" style={`max-width: ${maxWidth}`}>
    <Terminal title={terminalTitle} id={terminalId} animated={true} />
  </div>
</ContentSlide>
