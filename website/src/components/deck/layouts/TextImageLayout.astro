---
import ContentSlide from '../ContentSlide.astro';
import ImageFrame from '../ImageFrame.astro';

interface Props {
  eyebrow: string;
  title: string;
  titleSize?: string;
  sectionTag: string;
  bottomLeft?: string;
  bottomRight?: string;
  label?: string;
  placeholder?: string;
  imageCaption?: string;
  imageRatio?: string;
}

const { eyebrow, title, titleSize = `64px`, sectionTag, bottomLeft, bottomRight, label, placeholder, imageCaption, imageRatio = `4/3` } = Astro.props;
---

<ContentSlide sectionTag={sectionTag} bottomLeft={bottomLeft} bottomRight={bottomRight} label={label}>
  <div class="reveal reveal-1 font-mono text-sm tracking-[0.14em] text-[var(--fg-mute)] uppercase mb-7">
    {eyebrow}
  </div>

  <h2 class="slide-title reveal reveal-2 leading-[1.02] tracking-[-0.028em] font-medium m-0 mb-9 text-balance" style={`font-size: ${titleSize}`} set:html={title} />

  <div class="slide-cols-2 grid grid-cols-[1.15fr_0.85fr] reveal reveal-3 mt-6 gap-20 items-center">
    <div><slot /></div>
    <div>
      <ImageFrame placeholder={placeholder} caption={imageCaption} aspectRatio={imageRatio} />
    </div>
  </div>
</ContentSlide>
