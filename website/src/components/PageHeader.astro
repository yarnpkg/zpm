---
import Pill from './Pill.astro';

interface Props {
  title: string;
  lead: string;
  mono?: boolean;
  pill?: string;
}

const { title, lead, mono, pill } = Astro.props;
---

{(mono || pill) ? (
  <div class="flex items-center gap-3 flex-wrap mb-3">
    <h1 class="!m-0 font-mono tracking-[-0.02em]">
      {title}
    </h1>
    {pill && <Pill variant="since">{pill}</Pill>}
  </div>
) : (
  <h1>
    {title}
  </h1>
)}

<p class="lead">
  {lead}
</p>
