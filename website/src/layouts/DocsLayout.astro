---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PageHeader from '../components/PageHeader.astro';
import '../styles/theme.css';
import '../styles/docs.css';

interface Props {
  title: string;
  description?: string;
  breadcrumb?: string[];
  activePage?: string;
  mainMaxWidth?: string;
}

const { title, description, breadcrumb, activePage, mainMaxWidth = `780px` } = Astro.props;
---

<BaseLayout title={title} variant="docs" activePage={activePage} description={description}>
  <div class="max-w-[1320px] mx-auto px-6 grid grid-cols-1 md:grid-cols-[240px_minmax(0,1fr)] gap-8 lg:gap-14">

    <aside class="docs-sidebar">
      <slot name="sidebar" />
    </aside>

    <main class={`docs-main prose pt-10 pb-32 max-w-[${mainMaxWidth}]`}>
      {breadcrumb && <Breadcrumb segments={breadcrumb} />}
      {description && <PageHeader title={title} lead={description} />}
      <slot />
    </main>
  </div>

  <script is:inline src="/docs/docs.js"></script>
</BaseLayout>
