    var termTimers = new WeakMap();
    function animateTerminal(termEl) {
      var body = termEl.querySelector('.slide-terminal-body');
      if (!body) return;
      var recipeEl = termEl.querySelector('script.terminal-recipe');
      var recipe;
      if (recipeEl) {
        recipe = JSON.parse(recipeEl.textContent);
      } else {
        var bodyId = body.id;
        if (!bodyId || !TERMINALS[bodyId]) return;
        recipe = TERMINALS[bodyId];
      }
      if (!recipe) return;
      if (termTimers.has(termEl)) {
        termTimers.get(termEl).forEach(function(t) { clearTimeout(t); });
      }
      body.innerHTML = '';
      var timers = [];
      var t = 0;
      recipe.forEach(function(step, i) {
        t += step.delay;
        timers.push(setTimeout(function() {
          if (step.clear) {
            for (var c = 0; c < step.clear; c++) {
              if (body.lastChild) body.removeChild(body.lastChild);
            }
          }
          var span = document.createElement('span');
          span.className = 'line';
          span.innerHTML = step.html || '&nbsp;';
          body.appendChild(span);
          if (i === recipe.length - 1) {
            var cur = document.createElement('span');
            cur.className = 'cursor';
            body.lastChild.appendChild(cur);
          }
        }, t));
      });
      termTimers.set(termEl, timers);
    }

    setTimeout(function() {
      slides.forEach(function(s) { if (s.hasAttribute('data-deck-active')) onSlideActive(s); });
    }, 100);
  </script>

