---
import DocsLayout from '../../layouts/DocsLayout.astro';
import ReferenceSidebar from '../../components/ReferenceSidebar.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { schemaToMarkdown, schemaFieldNames } from '../../utils/schema';
import { renderDocsMarkdown } from '../../utils/render-markdown';

import schema from '../../../config/yarnrc.json';

const html = await renderDocsMarkdown(schemaToMarkdown(schema));
const fields = schemaFieldNames(schema);
---

<DocsLayout title="Settings (.yarnrc.yml)" activePage="yarnrc" mainMaxWidth="820px" description="Reference for all .yarnrc.yml configuration settings in Yarn.">
  <Fragment slot="sidebar">
    <ReferenceSidebar activePage="yarnrc" fields={fields} />
  </Fragment>

  <Breadcrumb segments={["Docs", "Reference", "Settings"]} />

  <PageHeader title="Settings (.yarnrc.yml)" lead="Allowed fields in .yarnrc.yml files" />

  <div class="prose" set:html={html} />
</DocsLayout>
